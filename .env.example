# Paths relative to this repository (absolute paths are also accepted).
DAY06_PATH=../K5-L3B-DAY06-NguyenHuuAn-2A202604024-DataIngestion
EMBEDDING_ENDPOINT=http://127.0.0.1:11434
EMBEDDING_MODEL=embeddinggemma-2:740m-mxfp8
EMBEDDING_DIGEST=a4efd357164f4bb30a45b0f0e7bc45e8dfa5be181de738c3227426624b3f8189
EMBEDDING_DIMENSIONS=768
# Quotes preserve the significant trailing space. Do not strip these values.
EMBEDDING_QUERY_PREFIX="task: search result | query: "
EMBEDDING_DOCUMENT_PREFIX="title: none | text: "
CONNECTION_TIMEOUT=10
# Set privately in .env or export DATABASE_URL; never commit credentials.
# Day06 local lab: host 127.0.0.1, port 55433, dbname day6_lab, user day6.
DATABASE_URL=
DATABASE_SCHEMA=public
DATABASE_TABLE=day6_chunks

# Công việc 05: model agent qua OpenAI API; điền riêng trong .env hoặc shell.
OPENAI_API_KEY=
OPENAI_MODEL=
# Empty means official https://api.openai.com/v1; set only for an explicit endpoint.
OPENAI_BASE_URL=
AGENT_MAX_MODEL_CALLS=4
AGENT_MAX_SEARCHES=3
AGENT_MAX_OUTPUT_TOKENS=2048
AGENT_TOP_K=3
# Unicode characters, serialized tool JSON; accumulated across unique outputs.
AGENT_TOOL_CHARS=6000
AGENT_CONTEXT_CHARS=16000
# Full serialized client history, including opaque reasoning, plus fixed schemas.
AGENT_HISTORY_CHARS=60000
AGENT_TIMEOUT_SECONDS=45
AGENT_MAX_RETRIES=0
# Use omit for models which do not accept reasoning.effort.
AGENT_REASONING_EFFORT=low
